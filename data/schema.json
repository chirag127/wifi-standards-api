{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://chirag127.github.io/wifi-standards/data/schema.json",
  "title": "Wi-Fi Standards",
  "description": "802.11 standards from legacy to Wi-Fi 7 with speeds and frequencies",
  "type": "array",
  "items": {
    "type": "object",
    "required": [
      "id",
      "name"
    ],
    "properties": {
      "id": {
        "type": "string",
        "description": "Unique identifier"
      },
      "name": {
        "type": "string",
        "description": "Display name"
      }
    }
  }
}
